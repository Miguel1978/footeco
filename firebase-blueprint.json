{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role management",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "coach", "viewer"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "role"]
    }
  },
  "firestore": {
    "users": {
      "schema": "UserProfile",
      "description": "User accounts and role metadata"
    }
  }
}
